# Frontend build configuration. All three are REQUIRED: `vite build` / `vite dev` fail if any is
# missing — there is no fallback project. Copy to .env.local (gitignored) for local work; set the
# same names in the hosting environment (Vercel) for deploys.
#
# Use the project's PUBLISHABLE key (sb_publishable_…), never a secret/service-role key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-ref>
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
