---
import { site, footerNav } from '../site.config.ts';
import Wordmark from './Wordmark.astro';

const year = new Date().getFullYear();
const { legal, contact } = site;

const columns = [
  { heading: 'Who we help', links: footerNav.whoWeHelp },
  { heading: 'Business advisory', links: footerNav.advisory },
  { heading: 'Tax & funding', links: footerNav.taxFunding },
  { heading: 'Firm', links: footerNav.firm },
];
---

<footer class="footer on-dark" data-screen-label="Footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <Wordmark href="/" />
        <p class="footer-blurb">{site.positioning}</p>
        <div class="footer-cta">
          <a href={site.cta.primaryUrl} class="btn btn-primary">{site.cta.primaryLabel}</a>
        </div>
        {contact.email && (
          <a class="footer-email" href={`mailto:${contact.email}`}>{contact.email}</a>
        )}
      </div>

      {
        columns.map((col) => (
          <div class="footer-col">
            <h2 class="footer-heading">{col.heading}</h2>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="footer-regulatory">
      <p>
        {site.name} is the trading name of {legal.entityName}, a company registered in
        England and Wales under company number {legal.companyNumber}. Registered office:
        {' '}{legal.registeredOffice}.
      </p>
      <p>
        The information on this website is general in nature and does not constitute
        accounting, tax, legal or investment advice. Advice should be obtained for your
        specific circumstances.
      </p>
    </div>

    <div class="footer-bottom">
      <span>© {year} {site.name} · All rights reserved</span>
      <div class="footer-legal">
        {footerNav.legal.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    </div>
  </div>
</footer>

<style is:global>
  .footer {
    background: var(--bg-3);
    color: var(--on-dark);
    padding: clamp(72px, 8vw, 112px) 0 36px;
  }
  .footer .container {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr;
    gap: clamp(24px, 3vw, 48px);
  }
  .footer .wordmark {
    color: var(--on-dark);
  }
  .footer .wordmark .mark {
    background: var(--on-dark-accent);
  }
  .footer-blurb {
    margin-top: 20px;
    color: var(--on-dark-muted);
    font-size: 14px;
    line-height: 1.7;
    max-width: 34ch;
  }
  .footer-cta {
    margin-top: 20px;
  }
  .footer-cta .btn-primary {
    background: var(--on-dark-accent);
    color: var(--bg-3);
  }
  .footer-cta .btn-primary:hover {
    background: var(--on-dark);
  }
  .footer-email {
    display: inline-block;
    margin-top: 18px;
    font-size: 14px;
    color: var(--on-dark);
    border-bottom: 1px solid var(--on-dark-line);
  }
  .footer-email:hover {
    color: var(--on-dark-accent);
  }
  .footer-heading {
    margin: 0 0 18px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-col a {
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--on-dark);
    transition: color 0.25s ease;
  }
  .footer-col a:hover {
    color: var(--on-dark-accent);
  }
  .footer-regulatory {
    color: var(--on-dark-muted);
    font-size: 12px;
    line-height: 1.7;
    max-width: 78ch;
  }
  .footer-regulatory p {
    margin: 0 0 10px;
  }
  .footer-bottom {
    border-top: 1px solid var(--on-dark-rule);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }
  .footer-bottom a {
    color: var(--on-dark-muted);
    transition: color 0.25s ease;
  }
  .footer-bottom a:hover {
    color: var(--on-dark);
  }
  .footer-legal {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
  }
  @media (max-width: 1080px) {
    .footer-top {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 680px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 460px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
</style>
