---
import { audiences } from '../data/pages.ts';
import Illustration from './Illustration.astro';
import Arrow from './Arrow.astro';
---

<div class="switcher reveal" style="--rd: 160ms">
  <ul class="switcher-list" role="tablist" aria-label="Who we help">
    {
      audiences.map((a, i) => (
        <li class:list={['switcher-item', { 'is-active': i === 0 }]} role="presentation">
          <button
            class="switcher-btn"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-target={a.slug}
            id={`tab-${a.slug}`}
            aria-controls={`panel-${a.slug}`}
          >
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="label">{a.navLabel}</span>
          </button>
        </li>
      ))
    }
  </ul>

  <div class="switcher-panel">
    {
      audiences.map((a, i) => (
        <article
          class:list={['panel', { 'is-active': i === 0 }]}
          id={`panel-${a.slug}`}
          role="tabpanel"
          aria-labelledby={`tab-${a.slug}`}
          hidden={i !== 0}
        >
          <div class="panel-grid">
            <div class="panel-copy">
              <span class="num">Client · {String(i + 1).padStart(2, '0')}</span>
              <h3>{a.navLabel}</h3>
              <p>{a.cardSummary}</p>
              <a href={a.path} class="learn-more">
                Learn more
                <Arrow />
              </a>
              {a.meta && (
                <div class="panel-meta">
                  {a.meta.slice(0, 2).map((m) => (
                    <span>
                      {m.label}
                      <strong>{m.value}</strong>
                    </span>
                  ))}
                </div>
              )}
            </div>
            <Illustration name={a.illustration} class="panel-plate" />
          </div>
        </article>
      ))
    }
  </div>
</div>

<!-- Mobile accordion (same data) -->
<ul class="acc-list">
  {
    audiences.map((a, i) => (
      <li class="acc-item">
        <details open={i === 0}>
          <summary class="acc-summary">
            <span>{a.navLabel}</span>
            <span class="plus" aria-hidden="true" />
          </summary>
          <div class="acc-body">
            <p>{a.cardSummary}</p>
            <a href={a.path} class="learn-more">
              Learn more
              <Arrow />
            </a>
          </div>
        </details>
      </li>
    ))
  }
</ul>

<style is:global>
  .switcher {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: clamp(24px, 4vw, 72px);
    align-items: start;
  }
  .switcher-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .switcher-item {
    border-bottom: 1px solid var(--rule);
  }
  .switcher-btn {
    width: 100%;
    background: transparent;
    border: 0;
    text-align: left;
    cursor: pointer;
    padding: 22px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(21px, 2.2vw, 28px);
    color: var(--ink-2);
    line-height: 1.15;
    transition: color 0.3s ease, padding 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    position: relative;
  }
  .switcher-btn::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0;
    height: 1px;
    background: var(--ink);
    transform: translateY(-50%);
    transition: width 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .switcher-btn .num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.14em;
    font-weight: 400;
    width: 36px;
    flex-shrink: 0;
  }
  .switcher-btn .label {
    flex: 1;
  }
  .switcher-btn:hover {
    color: var(--ink);
  }
  .switcher-item.is-active .switcher-btn {
    color: var(--ink);
    padding-left: 24px;
  }
  .switcher-item.is-active .switcher-btn::before {
    width: 14px;
  }
  .switcher-item.is-active .switcher-btn .label {
    font-style: italic;
  }
  .switcher-panel {
    position: relative;
    min-height: 360px;
  }
  .switcher-panel .panel {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition: opacity 0.5s ease, transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .switcher-panel .panel.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .panel-grid {
    display: grid;
    grid-template-columns: 5fr 4fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  .panel-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .panel-copy .num {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--muted);
  }
  .panel-copy h3 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(28px, 3.4vw, 42px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .panel-copy p {
    margin: 0;
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-2);
    max-width: 52ch;
  }
  .panel-meta {
    display: flex;
    gap: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .panel-meta span strong {
    display: block;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 12.5px;
    letter-spacing: 0;
    text-transform: none;
    font-weight: 500;
    margin-top: 4px;
  }
  .panel-plate {
    aspect-ratio: 4 / 3;
    min-height: 280px;
  }

  .acc-list {
    display: none;
  }
  @media (max-width: 980px) {
    .switcher {
      display: none;
    }
    .acc-list {
      display: block;
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--rule);
    }
    .acc-item {
      border-bottom: 1px solid var(--rule);
    }
    .acc-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 22px 0;
      cursor: pointer;
      font-family: var(--serif);
      font-size: 22px;
      line-height: 1.1;
      color: var(--ink);
      list-style: none;
    }
    .acc-summary::-webkit-details-marker {
      display: none;
    }
    .acc-summary .plus {
      width: 14px;
      height: 14px;
      position: relative;
      flex-shrink: 0;
    }
    .acc-summary .plus::before,
    .acc-summary .plus::after {
      content: '';
      position: absolute;
      background: var(--ink);
    }
    .acc-summary .plus::before {
      left: 0;
      right: 0;
      top: 6px;
      height: 1px;
    }
    .acc-summary .plus::after {
      top: 0;
      bottom: 0;
      left: 6px;
      width: 1px;
      transition: transform 0.3s;
    }
    .acc-item details[open] .acc-summary .plus::after {
      transform: scaleY(0);
    }
    .acc-body {
      padding: 0 0 28px;
      color: var(--ink-2);
      font-size: 15.5px;
      line-height: 1.7;
    }
    .acc-body p {
      margin: 0 0 16px;
    }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.switcher-btn'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.switcher-panel .panel'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('.switcher-item'));
  const ids = tabs.map((t) => t.dataset.target ?? '');

  function activate(target: string, focus = false) {
    if (!ids.includes(target)) return;
    tabs.forEach((t, i) => {
      const isMe = t.dataset.target === target;
      t.setAttribute('aria-selected', isMe ? 'true' : 'false');
      t.tabIndex = isMe ? 0 : -1;
      items[i]?.classList.toggle('is-active', isMe);
    });
    panels.forEach((p) => {
      const isMe = p.id === `panel-${target}`;
      p.classList.toggle('is-active', isMe);
      if (isMe) p.removeAttribute('hidden');
      else p.setAttribute('hidden', '');
    });
    if (focus) tabs.find((t) => t.dataset.target === target)?.focus();
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => activate(tab.dataset.target ?? ''));
    tab.addEventListener('keydown', (e) => {
      let next: number | null = null;
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = (i + 1) % tabs.length;
      else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;
      if (next !== null) {
        e.preventDefault();
        activate(tabs[next]!.dataset.target ?? '', true);
      }
    });
  });
</script>
