---
import { getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import Arrow from '../../components/Arrow.astro';
import { insightCategories } from '../../content.config.ts';
import { site } from '../../site.config.ts';
import {
  organizationNode,
  webPageNode,
  breadcrumbNode,
  graph,
} from '../../lib/schema.ts';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Insights', url: '/insights/' },
];
const title = `Insights — Accountancy, Tax, Funding and Exit | ${site.name}`;
const description =
  'Practical analysis of the accountancy, tax, financial-management, funding and exit issues that affect established businesses and their owners.';

// Published, non-draft articles, newest first.
const all = await getCollection('insights', ({ data }) => !data.draft);
const articles = all.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const dateFmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const catLabel = (slug: string) =>
  insightCategories.find((c) => c.slug === slug)?.label ?? slug;

const schema = graph([
  organizationNode(),
  webPageNode({ url: '/insights/', name: title, description, type: 'CollectionPage' }),
  breadcrumbNode(crumbs),
]);
---

<ContentLayout
  title={title}
  description={description}
  crumbs={crumbs}
  eyebrow="Insights"
  heading="Practical thinking for <em>business owners.</em>"
  lead={[
    'Clear analysis of the accountancy, tax, financial-management, funding and exit issues that affect established businesses and their owners.',
    'Each piece is written to help you understand the issue, ask the right questions and recognise when specific advice is needed.',
  ]}
  schema={schema}
>
  <div class="container">
    {
      articles.length > 0 ? (
        <section class="prose-section">
          <ul class="article-list">
            {articles.map((a) => (
              <li>
                <a href={`/insights/${a.id}/`} class="article-card">
                  <div class="article-meta">
                    <span class="cat">{catLabel(a.data.category)}</span>
                    <time datetime={a.data.publishDate.toISOString()}>
                      {dateFmt.format(a.data.publishDate)}
                    </time>
                  </div>
                  <h2>{a.data.title}</h2>
                  <p>{a.data.summary}</p>
                  <span class="card-link">
                    Read <Arrow />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ) : (
        <section class="prose-section">
          <div class="prose-grid">
            <h2>In preparation</h2>
            <div class="prose">
              <p>
                Our first articles are being written and reviewed. Rather than publish
                thin or generic content, we would rather publish pieces that genuinely
                help — properly sourced and worth your time.
              </p>
              <p>
                In the meantime, if there is a specific question on your mind, the quickest
                answer is usually a short conversation.
              </p>
            </div>
          </div>
        </section>
      )
    }

    <section class="prose-section">
      <div class="prose-grid">
        <h2>What we will cover</h2>
        <div>
          <ul class="cat-grid">
            {insightCategories.map((c) => <li>{c.label}</li>)}
          </ul>
        </div>
      </div>
    </section>
  </div>

  <CtaBand
    heading="Have a question we should <em>write about?</em>"
    copy="If there is something you are trying to understand or decide, tell us — it may be the subject of our next piece, or simply a conversation."
    secondaryLabel="Tell us about your affairs"
    secondaryHref="/contact/"
  />
</ContentLayout>

<style>
  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .article-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(28px, 3vw, 40px);
    background: var(--bg);
    transition: background 0.3s ease;
  }
  .article-card:hover {
    background: var(--bg-2);
  }
  .article-meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .article-card h2 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.15;
    color: var(--ink);
  }
  .article-card p {
    margin: 0;
    max-width: 68ch;
    color: var(--ink-2);
    font-size: 15.5px;
    line-height: 1.7;
  }
  .article-card .card-link {
    margin-top: 4px;
    font-size: 13px;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .article-card:hover .card-link {
    color: var(--accent);
  }
  .cat-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .cat-grid li {
    background: var(--bg);
    padding: 20px clamp(18px, 2vw, 24px);
    font-family: var(--serif);
    font-size: 18px;
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .cat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
