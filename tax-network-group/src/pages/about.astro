---
import ContentLayout from '../layouts/ContentLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../site.config.ts';
import {
  organizationNode,
  webPageNode,
  breadcrumbNode,
  graph,
} from '../lib/schema.ts';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' },
];
const title = `About ${site.name} | Boutique Business Accountants and Advisers`;
const description =
  'Tax Network Group is a boutique, senior-led accountancy and advisory firm for established businesses, ambitious founders and the people behind them. Learn about our approach and principles.';

const schema = graph([
  organizationNode(),
  webPageNode({ url: '/about/', name: title, description, type: 'AboutPage' }),
  breadcrumbNode(crumbs),
]);
---

<ContentLayout
  title={title}
  description={description}
  crumbs={crumbs}
  eyebrow="About"
  heading="An accountancy firm built for the decisions beyond <em>compliance.</em>"
  lead={[
    'Tax Network Group was created for business owners who want more than an annual set of accounts and a conversation shortly before a deadline.',
    'We combine dependable accounting and tax work with clearer information, forward planning and commercially relevant advice.',
  ]}
  schema={schema}
>
  <div class="container">
    <section class="prose-section">
      <div class="prose-grid">
        <h2>Why Tax Network Group exists</h2>
        <div class="prose">
          <p>
            Many established and ambitious owner-managed businesses sit in an underserved
            position. Their affairs have become too important and too complex for a basic,
            compliance-led service — but they do not need the cost, distance or structure of
            a large corporate firm.
          </p>
          <p>They want:</p>
          <ul>
            <li>reliable financial information they do not have to check</li>
            <li>senior attention rather than a hand-off down a chain</li>
            <li>clear explanations, in plain language</li>
            <li>proactive tax planning</li>
            <li>better preparation for important decisions</li>
            <li>a relationship proportionate to the business</li>
          </ul>
          <p>Tax Network Group is designed to provide exactly that level of support.</p>
        </div>
      </div>
    </section>

    <section class="prose-section">
      <div class="prose-grid">
        <h2>Our principles</h2>
        <div class="prose">
          <h3>Accuracy before interpretation</h3>
          <p>
            Advice is only as dependable as the accounting information beneath it. We get
            the foundations right before building anything more sophisticated on top.
          </p>
          <h3>Commercial context</h3>
          <p>
            Tax and accounting recommendations must be considered alongside the actual
            objective of the business, not in isolation.
          </p>
          <h3>Forward planning</h3>
          <p>
            The most valuable conversations usually happen before the transaction,
            commitment or deadline — not after it.
          </p>
          <h3>Clear accountability</h3>
          <p>
            Clients should understand who is responsible for each process, what will be
            delivered and when.
          </p>
          <h3>Selective by design</h3>
          <p>
            We work with clients where the relationship can make a meaningful difference.
            We are not trying to become the accountant for every business.
          </p>
        </div>
      </div>
    </section>

    <section class="prose-section">
      <div class="prose-grid">
        <h2>Senior-led advice</h2>
        <div class="prose">
          <p>
            Tax Network Group is senior-led. The person you speak to about your business is
            the person responsible for the advice — not a hand-off to someone more junior
            once the engagement begins.
          </p>
          <p>
            Where specialist or operational work is required, it is delivered through a
            carefully managed team and trusted specialists, with senior oversight retained
            throughout.
          </p>
          {/*
            PLACEHOLDER — founder biography. Before launch, replace this section with an
            accurate biography covering verified qualifications, professional-body
            memberships, previous roles that may be named, years of experience and the
            reason for establishing the firm. Do not publish unverified credentials.
          */}
          <div class="callout">
            <span class="callout-label">Founder profile — in preparation</span>
            <p>
              A full profile of the firm’s founder, including professional qualifications
              and background, will be published here once finalised.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="prose-section">
      <div class="prose-grid">
        <h2>A coordinated network for specialist advice</h2>
        <div class="prose">
          <p>
            Not every issue should be handled by the same adviser. Depending on the
            engagement, a client may also require legal, corporate-finance, wealth,
            pensions, valuation or specialist tax advice.
          </p>
          <p>
            Where appropriate, we work alongside your existing advisers or help coordinate
            suitable specialist input — keeping responsibilities and professional
            relationships clear. We do not imply that Tax Network Group provides regulated
            services it does not provide.
          </p>
        </div>
      </div>
    </section>
  </div>

  <CtaBand
    eyebrow="Get in touch"
    heading="A more useful relationship starts with a <em>better conversation.</em>"
    copy="Tell us about your business and what you need. We will use an introductory call to understand the position and whether Tax Network Group is the right fit."
    secondaryLabel="See who we help"
    secondaryHref="/who-we-help/"
  />
</ContentLayout>
