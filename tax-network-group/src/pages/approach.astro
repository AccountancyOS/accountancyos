---
import ContentLayout from '../layouts/ContentLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../site.config.ts';
import {
  organizationNode,
  webPageNode,
  breadcrumbNode,
  graph,
} from '../lib/schema.ts';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Approach', url: '/approach/' },
];
const title = `Our Approach | ${site.name}`;
const description =
  'How The Tax Network Group works: measured advice, long-term thinking and clear accountability. A considered, senior-led process for tax matters that deserve care.';

const schema = graph([
  organizationNode(),
  webPageNode({ url: '/approach/', name: title, description }),
  breadcrumbNode(crumbs),
]);

const steps = [
  {
    n: '01',
    h: 'Understand the position',
    p: 'We start with your situation, not a service. What the business does, how the family is placed, what is changing and which decisions are ahead. Good advice depends on understanding the whole picture.',
  },
  {
    n: '02',
    h: 'Establish reliable information',
    p: 'Advice cannot compensate for weak information. Where needed, we make sure the underlying records and figures are dependable before building anything more sophisticated on them.',
  },
  {
    n: '03',
    h: 'Agree what good looks like',
    p: 'Each engagement defines responsibilities, deliverables, deadlines and how we will communicate. You always know who is doing what, and what falls inside the agreed scope.',
  },
  {
    n: '04',
    h: 'Advise before the decision',
    p: 'We aim to raise issues, risks and opportunities while there is still time to act on them — rather than explaining, after the event, what might have been done.',
  },
];
---

<ContentLayout
  title={title}
  description={description}
  crumbs={crumbs}
  eyebrow="Approach"
  heading="Measured advice. <em>Long-term thinking.</em>"
  lead={[
    'Good tax advice is not just about forms, deadlines and calculations. It is about understanding the wider picture and giving advice that is technically robust, commercially sound and clearly explained.',
  ]}
  schema={schema}
>
  <div class="container">
    <section class="prose-section">
      <div class="prose-grid">
        <h2>What you can expect</h2>
        <div class="prose">
          <p>
            We believe clients are best served by advice that is thoughtful rather than
            rushed, personal rather than process-driven, and grounded in real expertise.
          </p>
          <p>
            In practice, that means direct answers in plain language, recommendations
            that account for the wider picture, and important matters handled with the
            discretion and technical depth they deserve.
          </p>
        </div>
      </div>
    </section>

    <section class="prose-section">
      <div class="prose-grid">
        <h2>How an engagement works</h2>
        <div>
          <ol class="steps">
            {
              steps.map((s) => (
                <li>
                  <span class="step-n">{s.n}</span>
                  <div>
                    <h3>{s.h}</h3>
                    <p>{s.p}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <section class="prose-section">
      <div class="prose-grid">
        <h2>Deliberate, not aggressive</h2>
        <div class="prose">
          <p>
            We advise on planning that is soundly based and defensible. We do not promote
            artificial or aggressive arrangements, and we are candid when the most sensible
            course is to accept a tax cost in exchange for a better commercial or personal
            outcome.
          </p>
          <div class="callout">
            <span class="callout-label">A note on advice</span>
            <p>
              Information on this website is general in nature. Tax outcomes depend on the
              relevant facts and the law in force at the time. Advice should be obtained
              for your specific circumstances before acting.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <CtaBand
    heading="Talk to someone who will take the <em>long view.</em>"
    copy="Arrange an introductory conversation to discuss your affairs and how we would approach them."
  />
</ContentLayout>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .steps li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: clamp(16px, 3vw, 32px);
    padding: 28px 0;
    border-top: 1px solid var(--rule);
  }
  .steps li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .step-n {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--muted);
    padding-top: 6px;
  }
  .steps h3 {
    margin: 0 0 8px;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(20px, 2.1vw, 26px);
    line-height: 1.2;
    color: var(--ink);
  }
  .steps p {
    margin: 0;
    color: var(--ink-2);
    font-size: 15.5px;
    line-height: 1.7;
    max-width: 60ch;
  }
</style>
