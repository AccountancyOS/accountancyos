---
import ContentLayout from '../layouts/ContentLayout.astro';
import { site } from '../site.config.ts';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Login', url: '/login/' },
];
---

<ContentLayout
  title={`Client Login | ${site.name}`}
  description="Secure client login for The Tax Network Group."
  noindex={true}
  crumbs={crumbs}
  eyebrow="Client area"
  heading="Secure client login."
  lead={['A secure area for existing clients.']}
>
  <div class="container">
    <section class="prose-section">
      <div class="prose">
        <div class="callout">
          <span class="callout-label">In preparation</span>
          <p>
            Our secure client portal is being finalised. Once available, existing clients
            will sign in here to share documents and correspond with us securely.
          </p>
          <p>
            In the meantime, please <a href="/contact/">contact us</a> and we will help
            directly.
          </p>
        </div>
      </div>
    </section>
  </div>
</ContentLayout>
