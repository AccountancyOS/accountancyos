---
import ContentLayout from '../layouts/ContentLayout.astro';
import { site } from '../site.config.ts';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Terms', url: '/terms/' },
];
---

<ContentLayout
  title={`Terms | ${site.name}`}
  description="Website terms for Tax Network Group."
  noindex={true}
  crumbs={crumbs}
  eyebrow="Legal"
  heading="Terms."
>
  <div class="container">
    <section class="prose-section">
      <div class="prose">
        <div class="callout">
          <span class="callout-label">Draft — requires approval before publication</span>
          <p>
            This page requires approval and completion using the final legal entity
            details and the firm's professional engagement structure. Website terms and
            the terms of any engagement are separate; nothing on this website forms a
            contract for services.
          </p>
        </div>
        <p>
          The information on this website is general in nature and does not constitute
          accounting, tax, legal or investment advice. Advice should be obtained for your
          specific circumstances.
        </p>
        <p>
          For any questions in the meantime, please <a href="/contact/">contact us</a>.
        </p>
      </div>
    </section>
  </div>
</ContentLayout>
