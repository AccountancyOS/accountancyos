# The Tax Network Group — environment configuration
# Copy to `.env` and complete before deploying.

# Canonical production origin (no trailing slash). Drives canonical tags,
# Open Graph URLs and the sitemap. PLACEHOLDER — confirm the real domain.
PUBLIC_SITE_URL="https://taxnetworkgroup.uk"

# Endpoint the enquiry / pre-booking forms POST to. PLACEHOLDER — wire to the
# firm's CRM, a form backend (e.g. Formspree) or a serverless function before
# launch. Until set, the form falls back to a mailto: on the enquiries address.
PUBLIC_FORM_ENDPOINT=""

# External scheduling tool embedded on /book-a-call/ (e.g. Cal.com / Calendly).
# PLACEHOLDER — leave blank to show the pre-booking form only.
PUBLIC_SCHEDULER_URL=""

# Secure client portal login destination. PLACEHOLDER.
PUBLIC_LOGIN_URL=""
